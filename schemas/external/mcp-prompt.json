{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-security.io/schemas/external/mcp-prompt.json",
  "title": "MCP Prompt (vendored)",
  "description": "Vendored copy of the Model Context Protocol Prompt type. Synced from MCP spec; update only as part of a major version bump.",
  "x-source": "https://modelcontextprotocol.io/specification#prompts",
  "x-vendor-version": "2024-11-05",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique identifier for the prompt within the bundle."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what this prompt does."
    },
    "arguments": {
      "type": "array",
      "description": "Input parameters the prompt accepts.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name":        { "type": "string" },
          "description": { "type": "string" },
          "required":    { "type": "boolean", "default": false },
          "default":     {}
        }
      }
    },
    "messages": {
      "type": "array",
      "description": "Templated message sequence the LLM evaluates.",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"]
          },
          "content": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "text"],
                "properties": {
                  "type": { "const": "text" },
                  "text": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["type", "data", "mimeType"],
                "properties": {
                  "type":     { "const": "image" },
                  "data":     { "type": "string", "contentEncoding": "base64" },
                  "mimeType": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    }
  }
}
